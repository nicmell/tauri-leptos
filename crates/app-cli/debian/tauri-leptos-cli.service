# The app server as a system service. cargo-deb installs this unit and
# enables + starts it; see docs/install/linux-systemd.md.
[Unit]
Description=tauri-leptos server
After=network.target

[Service]
# No account to create at install time: systemd allocates a transient user.
DynamicUser=yes
Environment=LEPTOS_SITE_ROOT=/usr/share/tauri-leptos/site
ExecStart=/usr/bin/tauri-leptos-cli --host 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

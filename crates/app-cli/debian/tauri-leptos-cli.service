# The app server as a system service. cargo-deb installs this unit and
# enables + starts it; see docs/install/linux-systemd.md.
[Unit]
Description=tauri-leptos server
After=network.target

[Service]
# No account to create at install time: systemd allocates a transient
# user and owns the state/cache/log directories below for it. The
# configuration directory stays root-owned, which is enough here because
# the deb ships config.toml — an app that must write its own config (or
# needs a fixed uid, or shared group access to a device) wants
# User=/Group= instead.
DynamicUser=yes
# Bind/site come from /etc/tauri-leptos/config.toml (shipped by the deb).
ExecStart=/usr/bin/tauri-leptos-cli serve
# systemd owns /etc/tauri-leptos, /var/lib/tauri-leptos, ... and exports
# the matching *_DIRECTORY env vars the app's path resolution picks up.
ConfigurationDirectory=tauri-leptos
StateDirectory=tauri-leptos
CacheDirectory=tauri-leptos
LogsDirectory=tauri-leptos
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

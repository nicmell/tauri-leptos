{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-leptos",
  "version": "0.1.0",
  "identifier": "com.nick.tauri-leptos",
  "build": {
    "beforeDevCommand": "cd .. && TAURI_LEPTOS_APP_DIR=appdir cargo leptos watch",
    "beforeBuildCommand": "cd .. && cargo leptos build --release",
    "devUrl": "http://127.0.0.1:3001"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../target/site/": "site/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

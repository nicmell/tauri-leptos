{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-leptos",
  "version": "0.1.0",
  "identifier": "com.nick.tauri-leptos",
  "build": {
    "beforeDevCommand": "trunk serve --config ../Trunk.toml",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --config ../Trunk.toml"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "tauri-leptos",
        "width": 800,
        "height": 600,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
